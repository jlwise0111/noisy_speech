# Copy to .env and edit. Paths are on the host machine.
# Folder scanned for clean/noisy/processed .wav files (mounted read-only).
# Default ".." = the project folder, so every system's outputs are found, e.g.
#   linear_baseline/outputs/<run>/   wiener_baseline/outputs/<run>/   neural_network/outputs/<run>/
# Use ./data for the bundled demo files only.
DATA_DIR=..
# Host port for the web UI (http://localhost:8501).
PORT=8501
